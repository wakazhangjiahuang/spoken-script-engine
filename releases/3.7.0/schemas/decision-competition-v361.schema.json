{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "spoken-script-engine marketing entry competition v3.6.1",
  "type": "object",
  "properties": {
    "marketing_entry_competition": {
      "$ref": "#/$defs/competition"
    },
    "topic_competitions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "plan_id",
          "competition"
        ],
        "properties": {
          "plan_id": {
            "type": "string",
            "minLength": 1
          },
          "competition": {
            "$ref": "#/$defs/competition"
          }
        }
      }
    }
  },
  "$defs": {
    "competition": {
      "type": "object",
      "required": [
        "candidates",
        "selected_candidate_id",
        "comparison_summary",
        "decision_reason",
        "tradeoffs"
      ],
      "properties": {
        "selected_candidate_id": {
          "type": "string",
          "minLength": 1
        },
        "comparison_summary": {
          "type": "string",
          "minLength": 30
        },
        "decision_reason": {
          "type": "string",
          "minLength": 30
        },
        "tradeoffs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 12
          }
        },
        "candidates": {
          "type": "array",
          "minItems": 3,
          "items": {
            "type": "object",
            "required": [
              "candidate_id",
              "entry_type",
              "target_user",
              "user_need",
              "hook",
              "click_reason",
              "promised_payoff",
              "evidence_refs",
              "delivery_plan",
              "commercial_value",
              "risk",
              "counter_evidence",
              "selected"
            ],
            "properties": {
              "candidate_id": {
                "type": "string",
                "minLength": 1
              },
              "entry_type": {
                "type": "string",
                "minLength": 4
              },
              "target_user": {
                "type": "string",
                "minLength": 12
              },
              "user_need": {
                "type": "string",
                "minLength": 12
              },
              "hook": {
                "type": "string",
                "minLength": 12
              },
              "click_reason": {
                "type": "string",
                "minLength": 12
              },
              "promised_payoff": {
                "type": "string",
                "minLength": 12
              },
              "evidence_refs": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string"
                }
              },
              "delivery_plan": {
                "type": "string",
                "minLength": 12
              },
              "commercial_value": {
                "type": "string",
                "minLength": 12
              },
              "risk": {
                "type": "string",
                "minLength": 12
              },
              "counter_evidence": {
                "type": "string",
                "minLength": 12
              },
              "selected": {
                "type": "boolean"
              },
              "selection_reason": {
                "type": "string"
              },
              "rejection_reason": {
                "type": "string"
              }
            }
          }
        }
      }
    }
  },
  "oneOf": [
    {
      "required": [
        "marketing_entry_competition"
      ],
      "not": {
        "required": [
          "topic_competitions"
        ]
      }
    },
    {
      "required": [
        "topic_competitions"
      ],
      "not": {
        "required": [
          "marketing_entry_competition"
        ]
      }
    }
  ]
}
