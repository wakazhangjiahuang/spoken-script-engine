{
  "type": "object",
  "required": [
    "brief",
    "scripts",
    "engine_version",
    "performance_status"
  ],
  "properties": {
    "brief": {
      "type": "object",
      "required": [
        "task_id",
        "topic",
        "audience",
        "goal",
        "platforms",
        "facts",
        "content_context",
        "voice_profile",
        "production_resources",
        "objective",
        "input_resolution",
        "content_task"
      ],
      "properties": {
        "task_id": {
          "type": "string",
          "minLength": 1
        },
        "topic": {
          "type": "string",
          "minLength": 1
        },
        "audience": {
          "type": "string",
          "minLength": 1
        },
        "goal": {
          "type": "string",
          "minLength": 1
        },
        "platforms": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "xiaohongshu",
              "douyin",
              "channels"
            ]
          }
        },
        "facts": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "text",
              "source",
              "status"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "text": {
                "type": "string",
                "minLength": 1
              },
              "source": {
                "type": "string",
                "minLength": 1
              },
              "status": {
                "enum": [
                  "provided",
                  "verified",
                  "hypothetical"
                ]
              }
            }
          }
        },
        "topic_locked": {
          "type": "boolean"
        },
        "stage_locked": {
          "type": "boolean"
        },
        "funnel_stage": {
          "enum": [
            "认知",
            "考虑",
            "行动",
            "使用"
          ]
        },
        "duration_limit_seconds": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "speech_chars_per_second": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 6
        },
        "content_context": {
          "type": "object",
          "required": [
            "scene",
            "problem",
            "memory_point",
            "content_type"
          ],
          "properties": {
            "scene": {
              "type": "string",
              "minLength": 1
            },
            "problem": {
              "type": "string",
              "minLength": 1
            },
            "memory_point": {
              "type": "string",
              "minLength": 1
            },
            "content_type": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "decision_stage": {
          "enum": [
            "认知",
            "兴趣",
            "信任",
            "考虑",
            "咨询/转化",
            "复购与传播"
          ]
        },
        "voice_profile": {
          "type": "string",
          "minLength": 1
        },
        "count_per_platform": {
          "type": "object",
          "required": [],
          "properties": {
            "xiaohongshu": {
              "type": "integer",
              "minimum": 1
            },
            "douyin": {
              "type": "integer",
              "minimum": 1
            },
            "channels": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        "production_resources": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "id",
              "description",
              "status"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "description": {
                "type": "string",
                "minLength": 1
              },
              "status": {
                "enum": [
                  "available",
                  "planned",
                  "unavailable"
                ]
              },
              "evidence_role": {
                "enum": [
                  "production_only",
                  "proof",
                  "demonstration"
                ]
              }
            }
          }
        },
        "objective": {
          "enum": [
            "inquiry",
            "trust",
            "education",
            "awareness",
            "purchase",
            "retention"
          ]
        },
        "input_resolution": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "formula_lock": {
          "type": "string",
          "pattern": "^SHARED:F[0-9]{2}$"
        },
        "content_task": {
          "enum": [
            "diagnosis",
            "correction",
            "tutorial",
            "case",
            "comparison",
            "objection",
            "planning",
            "retention"
          ]
        },
        "domain": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "scripts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "platform",
          "topic",
          "audience",
          "funnel_stage",
          "positioning",
          "angle",
          "formula_id",
          "hook_id",
          "title",
          "cover",
          "publish_description",
          "keywords",
          "segments",
          "claim_links",
          "unverified_claims",
          "selected_reason",
          "decision_stage",
          "value_translation",
          "hook_plan",
          "calling",
          "director_plan",
          "plan_id",
          "asset_applications",
          "cover_main",
          "cover_sub",
          "comment_hook"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "platform": {
            "enum": [
              "xiaohongshu",
              "douyin",
              "channels"
            ]
          },
          "topic": {
            "type": "string",
            "minLength": 1
          },
          "audience": {
            "type": "string",
            "minLength": 1
          },
          "positioning": {
            "type": "string",
            "minLength": 1
          },
          "funnel_stage": {
            "enum": [
              "认知",
              "考虑",
              "行动",
              "使用"
            ]
          },
          "angle": {
            "type": "object",
            "required": [
              "problem",
              "benefit",
              "proof_organization"
            ],
            "properties": {
              "problem": {
                "type": "string",
                "minLength": 1
              },
              "benefit": {
                "type": "string",
                "minLength": 1
              },
              "proof_organization": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "formula_id": {
            "type": "string",
            "pattern": "^SHARED:F[0-9]{2,}$"
          },
          "hook_id": {
            "type": "string",
            "pattern": "^SHARED:H[0-9]{2,}$"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "cover": {
            "type": "string",
            "minLength": 1
          },
          "publish_description": {
            "type": "string",
            "minLength": 1
          },
          "selected_reason": {
            "type": "string",
            "minLength": 1
          },
          "keywords": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "segments": {
            "type": "array",
            "minItems": 4,
            "items": {
              "type": "object",
              "required": [
                "id",
                "duration_seconds",
                "purpose",
                "text",
                "visual",
                "subtitle",
                "shot",
                "role"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1
                },
                "duration_seconds": {
                  "type": "number",
                  "exclusiveMinimum": 0
                },
                "purpose": {
                  "type": "string",
                  "minLength": 1
                },
                "text": {
                  "type": "string",
                  "minLength": 1
                },
                "visual": {
                  "type": "string",
                  "minLength": 1
                },
                "subtitle": {
                  "type": "string"
                },
                "notes": {
                  "type": "string"
                },
                "shot": {
                  "type": "object",
                  "required": [
                    "framing",
                    "camera",
                    "action",
                    "material_id",
                    "edit_cue",
                    "sound",
                    "subtitle_focus",
                    "silent_hold_seconds"
                  ],
                  "properties": {
                    "framing": {
                      "type": "string",
                      "minLength": 1
                    },
                    "camera": {
                      "type": "string",
                      "minLength": 1
                    },
                    "action": {
                      "type": "string",
                      "minLength": 1
                    },
                    "material_id": {
                      "type": "string",
                      "minLength": 1
                    },
                    "edit_cue": {
                      "type": "string",
                      "minLength": 1
                    },
                    "sound": {
                      "type": "string",
                      "minLength": 1
                    },
                    "subtitle_focus": {
                      "type": "string"
                    },
                    "silent_hold_seconds": {
                      "type": "number",
                      "minimum": 0
                    }
                  }
                },
                "role": {
                  "enum": [
                    "hook",
                    "suspense",
                    "context",
                    "judgment",
                    "value",
                    "calling"
                  ]
                }
              }
            }
          },
          "claim_links": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "segment_id",
                "evidence_id",
                "claim"
              ],
              "properties": {
                "segment_id": {
                  "type": "string",
                  "minLength": 1
                },
                "evidence_id": {
                  "type": "string",
                  "minLength": 1
                },
                "claim": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          },
          "unverified_claims": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "decision_stage": {
            "enum": [
              "认知",
              "兴趣",
              "信任",
              "考虑",
              "咨询/转化",
              "复购与传播"
            ]
          },
          "value_translation": {
            "type": "string",
            "minLength": 1
          },
          "hook_plan": {
            "type": "object",
            "required": [
              "alternate_hook_id",
              "alternate_text",
              "stop_reason",
              "continue_reason",
              "promise",
              "payoff_segment_id",
              "selection_reason"
            ],
            "properties": {
              "alternate_hook_id": {
                "type": "string",
                "pattern": "^SHARED:H[0-9]{2,}$"
              },
              "alternate_text": {
                "type": "string",
                "minLength": 1
              },
              "stop_reason": {
                "type": "string",
                "minLength": 1
              },
              "continue_reason": {
                "type": "string",
                "minLength": 1
              },
              "promise": {
                "type": "string",
                "minLength": 1
              },
              "payoff_segment_id": {
                "type": "string",
                "minLength": 1
              },
              "selection_reason": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "calling": {
            "type": "object",
            "required": [
              "kind",
              "line",
              "viewer_reason",
              "intent",
              "qualification",
              "next_step"
            ],
            "properties": {
              "kind": {
                "enum": [
                  "experience",
                  "question",
                  "choice",
                  "need",
                  "followup",
                  "resource",
                  "service",
                  "apply"
                ]
              },
              "line": {
                "type": "string",
                "minLength": 1
              },
              "viewer_reason": {
                "type": "string",
                "minLength": 1
              },
              "comment_signal": {
                "type": "string",
                "minLength": 1
              },
              "next_topic": {
                "type": "string",
                "minLength": 1
              },
              "channel_basis": {
                "type": "string",
                "minLength": 1
              },
              "intent": {
                "enum": [
                  "inquiry",
                  "trust",
                  "education",
                  "awareness",
                  "purchase",
                  "retention"
                ]
              },
              "qualification": {
                "type": "string",
                "minLength": 1
              },
              "next_step": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "director_plan": {
            "type": "object",
            "required": [
              "format",
              "visual_premise",
              "performance_note",
              "continuity",
              "editing_rule",
              "fallback",
              "shoot_order"
            ],
            "properties": {
              "format": {
                "type": "string",
                "minLength": 1
              },
              "visual_premise": {
                "type": "string",
                "minLength": 1
              },
              "performance_note": {
                "type": "string",
                "minLength": 1
              },
              "continuity": {
                "type": "string",
                "minLength": 1
              },
              "editing_rule": {
                "type": "string",
                "minLength": 1
              },
              "fallback": {
                "type": "string",
                "minLength": 1
              },
              "shoot_order": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          },
          "plan_id": {
            "type": "string",
            "minLength": 1
          },
          "asset_applications": {
            "type": "array",
            "minItems": 3,
            "items": {
              "type": "object",
              "required": [
                "role",
                "asset_id",
                "segment_id",
                "quote",
                "transformation"
              ],
              "properties": {
                "role": {
                  "enum": [
                    "hook",
                    "body",
                    "calling",
                    "platform"
                  ]
                },
                "asset_id": {
                  "type": "string",
                  "minLength": 1
                },
                "segment_id": {
                  "type": "string",
                  "minLength": 1
                },
                "quote": {
                  "type": "string",
                  "minLength": 1
                },
                "transformation": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          },
          "read_test": {
            "type": "object",
            "required": [
              "status"
            ],
            "properties": {
              "status": {
                "enum": [
                  "NOT_RUN",
                  "MEASURED"
                ]
              },
              "seconds": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "evidence": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "cover_main": {
            "type": "string",
            "minLength": 1
          },
          "cover_sub": {
            "type": "string",
            "minLength": 1
          },
          "comment_hook": {
            "type": "object",
            "required": [
              "line",
              "viewer_reason",
              "input",
              "next_step",
              "intent",
              "placement"
            ],
            "properties": {
              "line": {
                "type": "string",
                "minLength": 1
              },
              "viewer_reason": {
                "type": "string",
                "minLength": 1
              },
              "input": {
                "type": "string",
                "minLength": 1
              },
              "next_step": {
                "type": "string",
                "minLength": 1
              },
              "intent": {
                "type": "string",
                "minLength": 1
              },
              "placement": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    },
    "engine_version": {
      "enum": [
        "3.0.0"
      ]
    },
    "performance_status": {
      "enum": [
        "NOT_RUN"
      ]
    }
  }
}
