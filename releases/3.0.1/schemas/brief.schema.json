{
  "type": "object",
  "required": [
    "task_id",
    "topic",
    "audience",
    "goal",
    "platforms",
    "facts",
    "content_context",
    "voice_profile",
    "production_resources",
    "objective",
    "input_resolution",
    "content_task"
  ],
  "properties": {
    "task_id": {
      "type": "string",
      "minLength": 1
    },
    "topic": {
      "type": "string",
      "minLength": 1
    },
    "audience": {
      "type": "string",
      "minLength": 1
    },
    "goal": {
      "type": "string",
      "minLength": 1
    },
    "platforms": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "xiaohongshu",
          "douyin",
          "channels"
        ]
      }
    },
    "facts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "text",
          "source",
          "status"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "text": {
            "type": "string",
            "minLength": 1
          },
          "source": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": [
              "provided",
              "verified",
              "hypothetical"
            ]
          },
          "evidence_class": {
            "enum": [
              "user_project",
              "official_product",
              "research",
              "original_work",
              "historical_example",
              "hypothetical"
            ]
          },
          "anchor_terms": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "topic_locked": {
      "type": "boolean"
    },
    "stage_locked": {
      "type": "boolean"
    },
    "funnel_stage": {
      "enum": [
        "认知",
        "考虑",
        "行动",
        "使用"
      ]
    },
    "duration_limit_seconds": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "speech_chars_per_second": {
      "type": "number",
      "exclusiveMinimum": 0,
      "maximum": 6
    },
    "content_context": {
      "type": "object",
      "required": [
        "scene",
        "problem",
        "memory_point",
        "content_type"
      ],
      "properties": {
        "scene": {
          "type": "string",
          "minLength": 1
        },
        "problem": {
          "type": "string",
          "minLength": 1
        },
        "memory_point": {
          "type": "string",
          "minLength": 1
        },
        "content_type": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "decision_stage": {
      "enum": [
        "认知",
        "兴趣",
        "信任",
        "考虑",
        "咨询/转化",
        "复购与传播"
      ]
    },
    "voice_profile": {
      "type": "string",
      "minLength": 1
    },
    "count_per_platform": {
      "type": "object",
      "required": [],
      "properties": {
        "xiaohongshu": {
          "type": "integer",
          "minimum": 1
        },
        "douyin": {
          "type": "integer",
          "minimum": 1
        },
        "channels": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "production_resources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "description",
          "status"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": [
              "available",
              "planned",
              "unavailable"
            ]
          },
          "evidence_role": {
            "enum": [
              "production_only",
              "proof",
              "demonstration"
            ]
          },
          "supports_fact_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "objective": {
      "enum": [
        "inquiry",
        "trust",
        "education",
        "awareness",
        "purchase",
        "retention"
      ]
    },
    "input_resolution": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "formula_lock": {
      "type": "string",
      "pattern": "^SHARED:F[0-9]{2}$"
    },
    "content_task": {
      "enum": [
        "diagnosis",
        "correction",
        "tutorial",
        "case",
        "comparison",
        "objection",
        "planning",
        "retention"
      ]
    },
    "domain": {
      "type": "string",
      "minLength": 1
    },
    "timezone": {
      "type": "string",
      "minLength": 1
    },
    "explicit_technical_tutorial": {
      "type": "boolean"
    },
    "case_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "audience_information": {
      "type": "object",
      "required": [
        "primary_role",
        "current_problem",
        "direct_benefit",
        "information_type",
        "source_class"
      ],
      "properties": {
        "primary_role": {
          "type": "string",
          "minLength": 1
        },
        "current_problem": {
          "type": "string",
          "minLength": 1
        },
        "direct_benefit": {
          "type": "string",
          "minLength": 1
        },
        "information_type": {
          "type": "string",
          "minLength": 1
        },
        "source_class": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "event_family": {
      "type": "string",
      "minLength": 1
    },
    "copy_locks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "plan_id",
          "source"
        ],
        "properties": {
          "plan_id": {
            "type": "string"
          },
          "source": {
            "type": "string"
          },
          "cover_main": {
            "type": "string"
          },
          "cover_sub": {
            "type": "string"
          },
          "hook": {
            "type": "string"
          },
          "suspense": {
            "type": "string"
          },
          "allow_overlength": {
            "type": "boolean"
          },
          "allow_timing_overrun": {
            "type": "boolean"
          }
        }
      }
    }
  }
}
