{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Spoken Script Engine 3.8.0 V3 contracts",
  "$defs": {
    "adapter_route": {
      "type": "object",
      "required": [
        "primary_adapter_id",
        "adapter_version",
        "business_model",
        "route_reason",
        "overlay_adapter_ids",
        "route_confidence"
      ],
      "properties": {
        "primary_adapter_id": {
          "type": "string",
          "minLength": 1
        },
        "adapter_version": {
          "type": "string",
          "minLength": 1
        },
        "business_model": {
          "type": "string",
          "minLength": 1
        },
        "route_reason": {
          "type": "string",
          "minLength": 1
        },
        "overlay_adapter_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "route_confidence": {
          "enum": [
            "verified",
            "provisional"
          ]
        }
      }
    },
    "project_scope": {
      "type": "object",
      "required": [
        "project_id",
        "client_id",
        "rights_scope",
        "access_scope"
      ],
      "properties": {
        "project_id": {
          "type": "string",
          "minLength": 1
        },
        "client_id": {
          "type": "string",
          "minLength": 1
        },
        "rights_scope": {
          "type": "string",
          "minLength": 1
        },
        "access_scope": {
          "enum": [
            "current_task",
            "authorized_project"
          ]
        }
      }
    },
    "run_context": {
      "type": "object",
      "required": [
        "run_id",
        "execution_mode",
        "offer",
        "commercial_goal",
        "route",
        "knowledge"
      ],
      "properties": {
        "run_id": {
          "type": "string",
          "minLength": 1
        },
        "execution_mode": {
          "enum": [
            "proposal",
            "direct",
            "revision"
          ]
        },
        "offer": {
          "type": "string",
          "minLength": 1
        },
        "commercial_goal": {
          "type": "string",
          "minLength": 1
        },
        "route": {
          "$ref": "#/$defs/adapter_route"
        },
        "knowledge": {
          "type": "object"
        },
        "project_scope": {
          "$ref": "#/$defs/project_scope"
        },
        "production_mode": {
          "enum": [
            "none",
            "04",
            "05",
            "04+05"
          ]
        }
      }
    },
    "customer_decision": {
      "type": "object",
      "required": [
        "audience_id",
        "decision_id",
        "buyer_role",
        "context",
        "current_task",
        "root_need",
        "trigger",
        "alternative",
        "barrier",
        "decision_criterion",
        "benefit",
        "evidence_refs"
      ],
      "properties": {
        "audience_id": {
          "type": "string",
          "minLength": 1
        },
        "decision_id": {
          "type": "string",
          "minLength": 1
        },
        "buyer_role": {
          "type": "string",
          "minLength": 1
        },
        "context": {
          "type": "string",
          "minLength": 1
        },
        "current_task": {
          "type": "string",
          "minLength": 1
        },
        "root_need": {
          "type": "string",
          "minLength": 1
        },
        "trigger": {
          "type": "string",
          "minLength": 1
        },
        "alternative": {
          "type": "string",
          "minLength": 1
        },
        "barrier": {
          "type": "string",
          "minLength": 1
        },
        "decision_criterion": {
          "type": "string",
          "minLength": 1
        },
        "benefit": {
          "type": "string",
          "minLength": 1
        },
        "evidence_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "evidence_record": {
      "type": "object",
      "required": [
        "id",
        "source_id",
        "locator",
        "sha256",
        "scope",
        "rights",
        "status",
        "kind",
        "supported_statement",
        "claim_limit",
        "source_date"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "source_id": {
          "type": "string",
          "minLength": 1
        },
        "locator": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "scope": {
          "type": "string",
          "minLength": 1
        },
        "rights": {
          "enum": [
            "public",
            "authorized",
            "internal"
          ]
        },
        "status": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "type": "string",
          "minLength": 1
        },
        "supported_statement": {
          "type": "string",
          "minLength": 1
        },
        "claim_limit": {
          "type": "string",
          "minLength": 1
        },
        "source_date": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "category_choice": {
      "type": "object",
      "required": [
        "option",
        "alternative",
        "reason",
        "tradeoff"
      ],
      "properties": {
        "option": {
          "type": "string",
          "minLength": 1
        },
        "alternative": {
          "type": "string",
          "minLength": 1
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "tradeoff": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "project_choice": {
      "type": "object",
      "required": [
        "id",
        "status",
        "reason",
        "content_type",
        "claim_limit",
        "counter_evidence",
        "proof_refs"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "enum": [
            "ADVANTAGE_VERIFIED",
            "FIT_SUPPORTED",
            "INFO_ONLY",
            "PROJECT_CHOICE_PROOF_INSUFFICIENT",
            "BLOCKED"
          ]
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "content_type": {
          "type": "string",
          "minLength": 1
        },
        "claim_limit": {
          "type": "string",
          "minLength": 1
        },
        "counter_evidence": {
          "type": "string",
          "minLength": 1
        },
        "proof_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "marketing_entry": {
      "type": "object",
      "required": [
        "id",
        "angle",
        "question",
        "benefit",
        "payoff",
        "candidate_copy",
        "rationale",
        "proof_refs",
        "scores"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "angle": {
          "type": "string",
          "minLength": 1
        },
        "question": {
          "type": "string",
          "minLength": 1
        },
        "benefit": {
          "type": "string",
          "minLength": 1
        },
        "payoff": {
          "type": "string",
          "minLength": 1
        },
        "candidate_copy": {
          "type": "string",
          "minLength": 1
        },
        "rationale": {
          "type": "string",
          "minLength": 1
        },
        "proof_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "scores": {
          "type": "object"
        }
      }
    },
    "value_expression_map": {
      "type": "object",
      "required": [
        "feature",
        "capability",
        "capability_scope",
        "difference_or_fit",
        "benefit",
        "proof_refs",
        "purchase_reason_id",
        "entry_id",
        "platform_task",
        "expression",
        "claim_limit"
      ],
      "properties": {
        "feature": {
          "type": "string",
          "minLength": 1
        },
        "capability": {
          "type": "string",
          "minLength": 1
        },
        "capability_scope": {
          "type": "string",
          "minLength": 1
        },
        "difference_or_fit": {
          "type": "string",
          "minLength": 1
        },
        "benefit": {
          "type": "string",
          "minLength": 1
        },
        "proof_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "purchase_reason_id": {
          "type": "string",
          "minLength": 1
        },
        "entry_id": {
          "type": "string",
          "minLength": 1
        },
        "platform_task": {
          "type": "string",
          "minLength": 1
        },
        "expression": {
          "type": "string",
          "minLength": 1
        },
        "claim_limit": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "claim": {
      "type": "object",
      "required": [
        "id",
        "type",
        "text",
        "scope",
        "proof_refs"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "enum": [
            "fact",
            "fit",
            "comparison"
          ]
        },
        "text": {
          "type": "string",
          "minLength": 1
        },
        "scope": {
          "type": "string",
          "minLength": 1
        },
        "proof_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "topic_decision": {
      "type": "object",
      "required": [
        "as_of",
        "customer",
        "evidence",
        "category",
        "purchase",
        "entries",
        "value_map",
        "claims",
        "promise",
        "content_goal",
        "calling_action",
        "calling_reason",
        "calling_reward",
        "comment_task",
        "risk",
        "platform_difference",
        "series_id",
        "topic_type",
        "presentation_form",
        "narrative_mode",
        "funnel_stage",
        "unique_payoff"
      ],
      "properties": {
        "as_of": {
          "type": "string",
          "minLength": 1
        },
        "customer": {
          "$ref": "#/$defs/customer_decision"
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/evidence_record"
          }
        },
        "category": {
          "$ref": "#/$defs/category_choice"
        },
        "purchase": {
          "$ref": "#/$defs/project_choice"
        },
        "entries": {
          "type": "array",
          "minItems": 3,
          "items": {
            "$ref": "#/$defs/marketing_entry"
          }
        },
        "value_map": {
          "$ref": "#/$defs/value_expression_map"
        },
        "claims": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/claim"
          }
        },
        "promise": {
          "type": "string",
          "minLength": 1
        },
        "content_goal": {
          "type": "string",
          "minLength": 1
        },
        "calling_action": {
          "type": "string",
          "minLength": 1
        },
        "calling_reason": {
          "type": "string",
          "minLength": 1
        },
        "calling_reward": {
          "type": "string",
          "minLength": 1
        },
        "comment_task": {
          "type": "string",
          "minLength": 1
        },
        "risk": {
          "type": "string",
          "minLength": 1
        },
        "platform_difference": {
          "type": "string",
          "minLength": 1
        },
        "series_id": {
          "type": "string",
          "minLength": 1
        },
        "topic_type": {
          "type": "string",
          "minLength": 1
        },
        "presentation_form": {
          "type": "string",
          "minLength": 1
        },
        "narrative_mode": {
          "type": "string",
          "minLength": 1
        },
        "funnel_stage": {
          "type": "string",
          "minLength": 1
        },
        "unique_payoff": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "field_review": {
      "type": "object",
      "required": [
        "id",
        "quote",
        "reason",
        "status"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "quote": {
          "type": "string",
          "minLength": 1
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "enum": [
            "PASS",
            "FAIL",
            "NOT_RUN"
          ]
        }
      }
    },
    "gate_review": {
      "type": "object",
      "required": [
        "id",
        "fields",
        "reason",
        "status"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "fields": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "enum": [
            "PASS",
            "FAIL",
            "NOT_RUN"
          ]
        }
      }
    },
    "nine_field_review": {
      "type": "object",
      "required": [
        "plan_id",
        "fields",
        "gates"
      ],
      "properties": {
        "plan_id": {
          "type": "string",
          "minLength": 1
        },
        "fields": {
          "type": "array",
          "minItems": 9,
          "items": {
            "$ref": "#/$defs/field_review"
          },
          "maxItems": 9
        },
        "gates": {
          "type": "array",
          "minItems": 3,
          "items": {
            "$ref": "#/$defs/gate_review"
          },
          "maxItems": 3
        }
      }
    },
    "review": {
      "type": "object",
      "required": [
        "batch_sha256",
        "reviewer_id",
        "scripts"
      ],
      "properties": {
        "batch_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "reviewer_id": {
          "type": "string",
          "minLength": 1
        },
        "scripts": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/nine_field_review"
          }
        }
      }
    },
    "production_asset": {
      "type": "object",
      "required": [
        "id",
        "role",
        "source_id",
        "locator",
        "rights"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "role": {
          "enum": [
            "P01",
            "P02",
            "P03",
            "A01",
            "R"
          ]
        },
        "source_id": {
          "type": "string",
          "minLength": 1
        },
        "locator": {
          "type": "string",
          "minLength": 1
        },
        "rights": {
          "enum": [
            "public",
            "authorized"
          ]
        }
      }
    },
    "export_record": {
      "type": "object",
      "required": [
        "version",
        "file_name",
        "sha256",
        "sheet_names",
        "script_to_sheet",
        "lock_check",
        "readback_status",
        "acceptance_status"
      ],
      "properties": {
        "version": {
          "type": "string",
          "minLength": 1
        },
        "file_name": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "sheet_names": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "script_to_sheet": {
          "type": "object"
        },
        "lock_check": {
          "type": "string",
          "minLength": 1
        },
        "readback_status": {
          "type": "string",
          "minLength": 1
        },
        "acceptance_status": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "outcome_record": {
      "type": "object",
      "required": [
        "script_id",
        "status"
      ],
      "properties": {
        "script_id": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "enum": [
            "OBSERVED",
            "NOT_RUN"
          ]
        }
      }
    }
  }
}
