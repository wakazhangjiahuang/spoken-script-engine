{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "spoken-script-engine source evidence contract v3.6.1",
  "type": "object",
  "required": ["source_inventory"],
  "properties": {
    "source_inventory": {
      "type": "object",
      "required": ["status", "checked_assets", "fact_evidence", "relevant_real_case_ids", "selected_real_case_ids", "excluded_relevant_source_ids", "selection_reason"],
      "properties": {
        "status": {"enum": ["complete", "no_source_materials"]},
        "checked_assets": {"type": "array", "items": {"$ref": "#/$defs/sourceAsset"}},
        "fact_evidence": {"type": "array", "items": {"$ref": "#/$defs/factEvidence"}},
        "relevant_real_case_ids": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "selected_real_case_ids": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "excluded_relevant_source_ids": {"type": "array", "items": {"type": "object", "required": ["id", "reason"], "properties": {"id": {"type": "string"}, "reason": {"type": "string", "minLength": 20}}}},
        "selection_reason": {"type": "string", "minLength": 20},
        "no_source_reason": {"type": "string", "minLength": 20}
      }
    }
  },
  "$defs": {
    "sourceAsset": {
      "type": "object",
      "required": ["asset_id", "source_file", "source_sha256", "locator", "source_quote", "read"],
      "properties": {
        "asset_id": {"type": "string", "minLength": 1},
        "source_file": {"type": "string", "minLength": 1},
        "source_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "locator": {"type": "string", "minLength": 2},
        "source_quote": {"type": "string", "minLength": 4},
        "read": {"const": true},
        "extraction_method": {"type": "string"},
        "extraction_evidence_path": {"type": "string"},
        "extraction_evidence_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      }
    },
    "factEvidence": {
      "type": "object",
      "required": ["fact_id", "source_asset_id", "source_file", "source_sha256", "source_locator", "source_quote"],
      "properties": {
        "fact_id": {"type": "string", "minLength": 1},
        "source_asset_id": {"type": "string", "minLength": 1},
        "source_file": {"type": "string", "minLength": 1},
        "source_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "source_locator": {"type": "string", "minLength": 2},
        "source_quote": {"type": "string", "minLength": 4},
        "evidence_status": {"enum": ["USER_PROVIDED", "PUBLIC_SOURCE", "VERIFIED", "INFERENCE", "HYPOTHETICAL", "UNKNOWN", "NOT_RUN"]}
      }
    }
  }
}
